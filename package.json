{
  "name": "grailwind",
  "version": "0.6.0",
  "scripts": {
    "build": "tailwindcss -i docs/app.css -o docs/site.css",
    "dev": "tailwindcss -i docs/app.css -o docs/site.css --watch",
    "test": "node test/modes.mjs && npm test -w packages/eslint-plugin",
    "test:render": "node test/render.mjs",
    "dev:watch": "tailwindcss -i docs/app.css -o docs/site.css --watch=always & python3 -m http.server ${PORT:-8000} -d docs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "tailwindcss",
    "tailwind",
    "heraldry",
    "blazon",
    "css",
    "coat-of-arms",
    "coats-of-arms",
    "tailwindcss-plugin",
    "eslint"
  ],
  "author": "Paul Firmin",
  "license": "MIT",
  "description": "Heraldic blazon for Tailwind CSS: tinctures, divisions, ordinaries and charges",
  "devDependencies": {
    "@grailwind/eslint-plugin": "^0.1.0-beta.2",
    "@html-eslint/parser": "^0.67.0",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "~1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "style": "grailwind.css",
  "exports": {
    ".": {
      "style": "./grailwind.css",
      "default": "./grailwind.css"
    },
    "./strict": {
      "style": "./strict.css",
      "default": "./strict.css"
    },
    "./data": "./data.js"
  },
  "files": [
    "data.js",
    "grailwind.css",
    "divisions.js",
    "ordinaries.js",
    "charges.js",
    "furs.js",
    "strict.css",
    "palette-reset.css",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "homepage": "https://grailwind.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pafirmin/grailwind.git"
  },
  "bugs": {
    "url": "https://github.com/pafirmin/grailwind/issues"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
