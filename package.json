{
  "name": "grailwind",
  "version": "0.2.0",
  "scripts": {
    "build": "tailwindcss -i docs/app.css -o docs/site.css",
    "dev": "tailwindcss -i docs/app.css -o docs/site.css --watch",
    "test": "node test/modes.mjs",
    "dev:watch": "tailwindcss -i docs/app.css -o docs/site.css --watch=always & python3 -m http.server ${PORT:-8000} -d docs"
  },
  "keywords": [
    "tailwindcss",
    "tailwind",
    "heraldry",
    "blazon",
    "css"
  ],
  "author": "Paul Firmin",
  "license": "MIT",
  "description": "Heraldic blazon for Tailwind CSS: tinctures, divisions, ordinaries and charges",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "type": "module",
  "style": "grailwind.css",
  "exports": {
    ".": {
      "style": "./grailwind.css",
      "default": "./grailwind.css"
    },
    "./strict": {
      "style": "./strict.css",
      "default": "./strict.css"
    }
  },
  "files": [
    "grailwind.css",
    "divisions.js",
    "ordinaries.js",
    "charges.js",
    "strict.css",
    "palette-reset.css",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "homepage": "https://pafirmin.github.io/grailwind/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pafirmin/grailwind.git"
  },
  "bugs": {
    "url": "https://github.com/pafirmin/grailwind/issues"
  }
}
